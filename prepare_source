pkg=gnutls28
version_orig="3.8.9"
version="$version_orig-2"
version_suffix="gl0~bp1592"

apt-get install -y wget

workdir=$(mktemp -d)

git clone --depth 1 --branch "$version" https://salsa.debian.org/gnutls-team/gnutls $workdir

wget http://deb.debian.org/debian/pool/main/g/gnutls28/gnutls28_3.8.9.orig.tar.xz
tar xvf gnutls28_3.8.9.orig.tar.xz --strip-components=1 -C $workdir/

pushd "$workdir"
rm -rf ./.git
popd 

import_src $workdir

rm -rf $workdir


