pkg=gnutls28
version_orig=3.8.11
version="${version_orig}-3"
version_suffix="gl1+bp1592"

git_src -b "${version}" https://salsa.debian.org/gnutls-team/gnutls.git
git_src -b "${version_orig}" https://gitlab.com/gnutls/gnutls.git

apply_patches debian_fixes

apt-get install bison gperf gtk-doc wget

# Bootstrap and repack original (Git) sources as they are modified by the script after checkout by intend and magic
pushd ${dir}/src

unlink ${dir}/orig.tar
./bootstrap --copy
tar -cf ../orig.tar .

popd
